          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(enricher_search_global_duration_seconds_sum{object_class=~\"$object_class\"}[1m])) / clamp_min(sum(rate(enricher_search_global_duration_seconds_count{object_class=~\"$object_class\"}[1m])), 1e-9)",
          "legendFormat": "global_avg",
          "refId": "A"
        },
        {
          "expr": "sum(rate(enricher_search_parent_duration_seconds_sum{object_class=~\"$object_class\"}[1m])) / clamp_min(sum(rate(enricher_search_parent_duration_seconds_count{object_class=~\"$object_class\"}[1m])), 1e-9)",
          "legendFormat": "parent_avg",
          "refId": "B"
        },
        {
          "expr": "sum(rate(enricher_search_revision_duration_seconds_sum{object_class=~\"$object_class\"}[1m])) / clamp_min(sum(rate(enricher_search_revision_duration_seconds_count{object_class=~\"$object_class\"}[1m])), 1e-9)",
          "legendFormat": "revision_avg",
          "refId": "C"
        },
        {
          "expr": "sum(rate(enricher_search_global_item_duration_seconds_sum[1m])) / clamp_min(sum(rate(enricher_search_global_item_duration_seconds_count[1m])), 1e-9)",
          "legendFormat": "global_item_avg",
          "refId": "D"
        }
      ],
      "title": "Search Call Latency Avg (1m)",
      "type": "timeseries"
    },
    {
      "datasource": {
