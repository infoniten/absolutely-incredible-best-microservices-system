      "targets": [
        {
          "expr": "100 * sum(rate(enricher_search_global_errors_total{object_class=~\"$object_class\"}[1m])) / clamp_min(sum(rate(enricher_search_global_count_total{object_class=~\"$object_class\"}[1m])), 1e-9)",
          "legendFormat": "global_error_rate",
          "refId": "A"
