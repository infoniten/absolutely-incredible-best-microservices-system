          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (object_class) (rate(enricher_search_global_count_total{object_class=~\"$object_class\"}[1m]))",
          "legendFormat": "global {{object_class}}",
          "refId": "A"
        },
        {
          "expr": "sum by (object_class) (rate(enricher_search_parent_count_total{object_class=~\"$object_class\"}[1m]))",
          "legendFormat": "parent {{object_class}}",
          "refId": "B"
        },
        {
          "expr": "sum by (object_class) (rate(enricher_search_revision_count_total{object_class=~\"$object_class\"}[1m]))",
          "legendFormat": "revision {{object_class}}",
          "refId": "C"
        },
        {
          "expr": "sum(rate(enricher_search_global_item_count_total[1m]))",
          "legendFormat": "global_item",
          "refId": "D"
        }
      ],
      "title": "Search-Service Calls RPS",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
