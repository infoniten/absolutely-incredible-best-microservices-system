  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "query_result(sum by (object_class) (rate(enricher_search_global_count_total[1m])) or sum by (object_class) (rate(enricher_search_parent_count_total[1m])) or sum by (object_class) (rate(enricher_search_revision_count_total[1m])))",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "object_class",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "query_result(sum by (object_class) (rate(enricher_search_global_count_total[1m])) or sum by (object_class) (rate(enricher_search_parent_count_total[1m])) or sum by (object_class) (rate(enricher_search_revision_count_total[1m])))",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "/object_class=\"([^\"]+)\"/",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
